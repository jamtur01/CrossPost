# SwiftFormat is the formatting arbiter. Run `./lint.sh --fix` to apply.
--swiftversion 6.0
--exclude build,DerivedData,CrossPost.xcodeproj

--indent 4
--maxwidth 120
--self remove
# No trailing commas: matches SwiftLint's trailing_comma rule.
--commas inline

# K&R braces. SwiftLint's opening_brace wins where the two disagree, so the
# SwiftFormat rule that moves `{` onto its own line after a wrapped condition is off.
--disable wrapMultilineStatementBraces

# Tests may force-unwrap (see Tests/.swiftlint.yml); don't rewrite them.
--disable noForceUnwrapInTests
